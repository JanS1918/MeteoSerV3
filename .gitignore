# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# PyInstaller
*.manifest
*.spec

# IDE / Editor
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs and runtime
logs/
*.log

# Data generated at runtime (keep only source-controlled examples)
data/*.json
data/*.jsonl

# Secrets
.env
secrets.json
scripts/generated_password.txt

# Ignore compiled python caches anywhere
**/__pycache__/
**/*.pyc
.vscode/
.venv/
archive/logs/
archive/tests/
archive/disabled_bats/
archive/demo/
# Runtime logs and transient state (managed by service, should not be tracked)
logs/
data/last_*.json
data/asistente_estado.json
data/pas_profiles.json
data/habits_profile.json
data/last_sensores.json
data/last_ecowitt_payload.json
data/last_location.json